includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - routes/
        - database/
    level: 6
    ignoreErrors:
        # Traits de Enum ficam prontos antes do primeiro Enum de negócio usá-los.
        -
            identifier: trait.unused
            path: app/Enums/Concerns/*
            reportUnmatched: false
