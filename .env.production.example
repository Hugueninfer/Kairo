# Copie para .env.production e preencha. Nunca coloque este arquivo no Git.

# Domínio do Kairo, já apontando (DNS tipo A) para o IP do servidor.
APP_DOMAIN=kairo.seudominio.com.br

# Gere com: docker run --rm kairo-api php artisan key:generate --show
# (ou, com PHP na máquina: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;")
APP_KEY=

# Senha do Postgres (crie uma longa, ex.: openssl rand -hex 24).
DB_PASSWORD=

# Chaves do WebSocket (Reverb). A APP_KEY é pública (vai para o navegador); a SECRET não.
REVERB_APP_KEY=
REVERB_APP_SECRET=

# E-mail (Resend, Amazon SES, Mailgun, Brevo... qualquer SMTP).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=nao-responda@seudominio.com.br

# Gateway de pagamento. "fake" simula os pagamentos.
PAYMENT_GATEWAY=fake
FAKE_GATEWAY_WEBHOOK_TOKEN=
