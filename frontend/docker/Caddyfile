# Porta de entrada do Kairo em produção.
# Com um domínio em APP_DOMAIN, o Caddy emite e renova o certificado HTTPS sozinho (Let's Encrypt).
{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# API, sessão (CSRF) e checagem de saúde vão para o Laravel.
	@api path /api/* /sanctum/* /up
	handle @api {
		reverse_proxy app:8000
	}

	# WebSocket dos boards (Laravel Reverb).
	@reverb path /app/* /apps/*
	handle @reverb {
		reverse_proxy reverb:8080
	}

	# O resto é o front (SPA): rotas desconhecidas caem no index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}

		# Arquivos com hash no nome podem ficar em cache para sempre; o index.html nunca.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
}
