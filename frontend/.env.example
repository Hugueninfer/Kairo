# URL base da API. Vazio usa a mesma origem (proxy do Vite em dev).
VITE_API_URL=
# Para onde o proxy do Vite envia /api e /sanctum em desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8000
# Tempo real dos boards (Laravel Reverb). Sem a chave, o board funciona sem colaboração ao vivo.
VITE_REVERB_APP_KEY=kairo-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
